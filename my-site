            border-radius: 22px;
            padding: 40px 35px;
            position: relative;
            overflow: hidden;
            transition: all 0.35s;
        }
        .discord-block:hover {
            box-shadow: 0 20px 60px rgba(88, 101, 242, 0.3);
            transform: translateY(-5px);
        }
        .discord-block h3 {
            color: #7289da;
            font-size: 24px;
            margin-bottom: 15px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .discord-block p {
            color: #c8c8d5;
            line-height: 1.8;
            font-size: 16px;
            margin-bottom: 14px;
        }

        .contact-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 22px;
        }
        .contact-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 15px 32px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            color: #fff;
        }
        .contact-btn.tg {
            background: linear-gradient(135deg, #229ed9, #0088cc);
            box-shadow: 0 10px 35px rgba(34, 158, 217, 0.5);
        }
        .contact-btn.ds {
            background: linear-gradient(135deg, #5865f2, #8b5cf6);
            box-shadow: 0 10px 35px rgba(88, 101, 242, 0.5);
