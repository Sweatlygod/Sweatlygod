            background: #0d0d1a;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid rgba(0, 255, 136, 0.3);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            position: relative;
            z-index: 1;
        }
        .terminal-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.04);
            border-bottom: 1px solid rgba(0, 255, 136, 0.15);
        }
        .dot {
            width: 12px; height: 12px;
            border-radius: 50%;
            display: inline-block;
        }
        .dot.red { background: #ff5f57; }
        .dot.yellow { background: #febc2e; }
        .dot.green { background: #28c840; }
        .terminal-title {
            margin-left: auto;
            color: #6a6a80;
            font-size: 12px;
            font-family: 'JetBrains Mono', monospace;
        }
        .terminal-body {
            padding: 18px 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 14px;
            line-height: 1.9;
        }
        .terminal-body p { color: #c8c8d5; }
        .prompt { color: #00ff88; font-weight: 700; }
        .output { color: #9a9aad; padding-left: 18px; }
        .hl { color: #ff9800; font-weight: 700; }
        .hl-green { color: #00ff88; font-weight: 700; }
        .cursor {
            color: #00ff88;
            animation: blink 1s step-end infinite;
        }
        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .coder-text { position: relative; z-index: 1; }
        .coder-text h3 {
            color: #00ff88;
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 14px;
