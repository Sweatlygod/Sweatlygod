        .code-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .code-tag {
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid rgba(0, 255, 136, 0.4);
            color: #00ff88;
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 8px;
            transition: all 0.3s;
        }
        .code-tag:hover {
            background: #00ff88;
            color: #0a0a1a;
            transform: translateY(-2px);
        }

        .tier-badge {
            max-width: 700px;
            margin: 0 auto;
            background: linear-gradient(135deg, rgba(255, 152, 0, 0.12), rgba(168, 85, 247, 0.12));
            border: 1px solid rgba(255, 152, 0, 0.35);
            border-radius: 22px;
            padding: 38px 32px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 60px rgba(255, 152, 0, 0.15);
        }
        .tier-badge::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: conic-gradient(from 0deg, transparent, rgba(255, 152, 0, 0.08), transparent 30%);
            animation: spin 12s linear infinite;
            pointer-events: none;
        }
        .tier-badge h3 {
            text-align: center;
            color: var(--accent1);
            font-size: 22px;
            margin-bottom: 25px;
            font-weight: 800;
            position: relative;
            z-index: 1;
        }
        .tier-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px dashed rgba(255, 152, 0, 0.25);
            position: relative;
            z-index: 1;
            font-size: 16px;
        }
        .tier-row:last-child { border-bottom: none; }
        .tier-label {
            color: var(--muted);
            font-weight: 600;
        }
        .tier-value {
            color: #fff;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 600;
            background: rgba(255, 152, 0, 0.15);
            padding: 6px 14px;
            border-radius: 10px;
            border: 1px solid rgba(255, 152, 0, 0.35);
        }
        .tier-value.highlight {
            background: linear-gradient(135deg, var(--accent1), var(--accent2));
            color: #fff;
            border: none;
            box-shadow: 0 4px 20px rgba(255, 87, 34, 0.5);
        }

        .contacts {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }
        .contacts a {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 14px 26px;
            background: rgba(255, 152, 0, 0.12);
            border: 1px solid rgba(255, 152, 0, 0.5);
            border-radius: 30px;
            color: var(--accent1);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
        }
        .contacts a:hover {
            background: linear-gradient(135deg, var(--accent1), var(--accent2));
            color: #fff;
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 12px 35px rgba(255, 87, 34, 0.5);
        }

        footer {
            text-align: center;
            padding: 50px 20px 30px;
            color: #5a5a6e;
            font-size: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
