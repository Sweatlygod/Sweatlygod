            .tier-row { font-size: 14px; flex-direction: column; gap: 8px; align-items: flex-start; }
            .coder-badge { grid-template-columns: 1fr; padding: 25px 20px; }
            .terminal-body { font-size: 12px; }
            .coder-text h3 { font-size: 22px; }
        }
    </style>
</head>
